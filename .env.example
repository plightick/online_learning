# Backend
PORT=8080
# Local / Docker Compose (JDBC). Production on Railway: set DATABASE_JDBC_URL instead (see below).
DB_URL=jdbc:postgresql://postgres:5432/online_learning
DB_USERNAME=postgres
DB_PASSWORD=postgres
# Railway backend: add variable DATABASE_JDBC_URL and build it from the linked Postgres service, e.g.
# jdbc:postgresql://${{ Postgres.PGHOST }}:${{ Postgres.PGPORT }}/${{ Postgres.PGDATABASE}}
# Use your Postgres service name in place of Postgres if it differs. PGUSER/PGPASSWORD are usually injected when the database is linked.
# DATABASE_JDBC_URL=jdbc:postgresql://...
# Comma-separated CORS origin patterns for /api/** (Spring relaxed binding: APP_CORS_ALLOWED_ORIGIN_PATTERNS).
# Local defaults are in application.properties; on Railway set your public frontend URL, e.g.:
# APP_CORS_ALLOWED_ORIGIN_PATTERNS=https://your-frontend.up.railway.app

# Frontend (Docker runtime-config)
API_BASE_URL=http://localhost:8080

